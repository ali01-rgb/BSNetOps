generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String            @id @default(uuid())
  employeeId         String            @unique                // ID Staff (BSN-USR-001)
  email              String?           @unique                // Dibuat opsional (String?)
  password           String?                                  
  fullName           String?                                  
  cabang             String?                                  // 🔥 DITAMBAHKAN: Penempatan Cabang
  unit               String?                                  // 🔥 DITAMBAHKAN: Unit (CWO, Teller, dll)
  divisi             String?                                  
  phone              String?                                  
  avatar             String?
  role               String            @default("USER")       
  hasSignedUp        Boolean           @default(true)        
  isVerified         Boolean           @default(true)         
  isFirstLogin       Boolean           @default(true)         // 🔥 DITAMBAHKAN: Trigger wajib ganti password
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  requests           Request[] 
  notifications      Notification[]
  is_suspended       Boolean?          @default(false)
  deleted_at         DateTime?
}

model Request {
  id                 String    @id @default(uuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id])
  assetId            String?
  asset              Asset?    @relation(fields: [assetId], references: [id])
  nama_aset          String
  jumlah             Int
  jumlah_disetujui   Int?      
  catatan_admin      String?
  prioritas          String
  tanggal_dibutuhkan DateTime
  alasan             String?
  status             String    @default("Pending")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  adminName          String?   // Akan terisi saat Admin klik 'Diteruskan'
  managerName        String?   // Akan terisi saat Manager klik 'Disetujui'
}

// --- TABEL KATEGORI BARANG ---
model Category {
  id            String    @id @default(uuid())
  category_code String?   @unique
  name          String
  description   String?
  deleted_at    DateTime? 
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  assets        Asset[]
}

// --- TABEL ASSET (Stok Barang Gabungan) ---
model Asset {
  id                  String    @id @default(uuid())
  kode_barang         String    @unique
  nama_barang         String
  stok                Int       @default(0)
  location            String?
  status              String    @default("Aman")
  image_url           String?
  deleted_at          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  categoryId          String?
  category            Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  kategori_sebelumnya String? 

  requests            Request[]
}

model Notification {
  id        String   @id @default(uuid())
  title     String   
  message   String   
  type      String   @default("info") 
  target    String   
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  // Relasi ke tabel User
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}