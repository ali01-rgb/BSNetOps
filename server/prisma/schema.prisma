generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id @default(uuid())
  employeeId  String   @unique              // Sesuai form: ID Staff
  username    String   @unique              // Sesuai form Register & Login
  email       String   @unique              // Buat reset password & login
  password    String?                        
  fullName    String?                       // Tetap ada buat nama asli karyawan
  role        String   @default("USER")     
  hasSignedUp Boolean  @default(false)      
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}